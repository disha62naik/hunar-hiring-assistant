# --- Server ---
DATABASE_URL=sqlite:///./hunar.db
FRONTEND_ORIGIN=http://localhost:3000
# Public URL this backend is reachable at (used to build the webhook callback URL for Hunar).
# In local dev, use an ngrok/localtunnel URL. In production, your Render/Railway URL.
PUBLIC_BACKEND_URL=https://aftermath-smirk-turret.ngro

# --- Hunar Voice AI ---
HUNAR_API_KEY=changeme
HUNAR_BASE_URL=https://api.voice.hunar.ai/external/v1
# One of: NEHA, ROY, ZOE, SAM, MIRA, EESHA
HUNAR_VOICE_PERSONA=NEHA
# One of: ENGLISH, HINDI, TAMIL, TELUGU, KANNADA, MARATHI, MALAYALAM, GUJARATI, BENGALI, TURKISH, ARABIC, SPANISH
HUNAR_LANGUAGE=ENGLISH
# Optional: extra active API keys (comma-separated) to trust when verifying
# webhook signatures, if your org has more than one. HUNAR_API_KEY above is
# always trusted automatically -- only set this if you have additional keys.
HUNAR_WEBHOOK_API_KEYS=

# --- People Search (pick ONE provider and fill its key) ---
PEOPLE_SEARCH_PROVIDER=apollo
APOLLO_API_KEY=changeme
PDL_API_KEY=changeme

# --- Optional: LLM for JD parsing / question generation / candidate summaries ---
# Leave blank to fall back to simple keyword-based parsing.
ANTHROPIC_API_KEY=
